# Wei Journal - the example of the local environment file
#
# Copy this file to `.env` and fill in the values of this machine:
#
#     cp .env.example .env
#
# `.env` is ignored by git, because it holds the secrets of the installation.
# The settings that are not secret live in `config.env`, which is committed
# and travels with the code. A value in `.env` overrides the same value in
# `config.env`, so this file holds the differences between the machines and
# `config.env` holds the shared behaviour.
#
# Every value here is optional. With an empty `.env` the journal still starts
# and the first account that registers through the interface becomes the
# administrator.

# ---------------------------------------------------------------------------
# The first administrator
# ---------------------------------------------------------------------------

# The password of the first administrator account, seeded on the very first
# start when the database is empty. At least 10 characters. Leave it empty to
# create the administrator through the web interface instead, in which case
# the first account that registers becomes the administrator.
# REQUIRED when you want a scripted first administrator.
WJ_ADMIN_PASSWORD=

# The username of the first administrator account. Leave empty to register
# through the interface instead.
WJ_ADMIN_USERNAME=

# The email address of the first administrator. Optional.
WJ_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# The host port the web interface is published on. The API itself is never
# published, it is only reachable through the frontend.
WJ_HTTP_PORT=8088

# ---------------------------------------------------------------------------
# The model provider (optional)
# ---------------------------------------------------------------------------

# The API key of the model provider. Leave empty to run without any model.
# The journal works without one; only the derived image descriptions and the
# summaries are missing.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# The Chinese place service (optional)
# ---------------------------------------------------------------------------

# The key of the Chinese place service, used when WJ_GEOCODING_PROVIDER is
# set to "amap" in config.env. It must be a "web service" key; a JavaScript
# one is refused by the service. Leave it empty to keep the place search on
# the OpenStreetMap service, which needs no key.
WJ_AMAP_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL (optional, only with the profile "postgres")
# ---------------------------------------------------------------------------

# The database connection. Leave it empty for the embedded SQLite database,
# which is the default. For PostgreSQL use:
#   WJ_DATABASE_URL=postgres://journal:change-me@postgres:5432/journal?sslmode=disable
WJ_DATABASE_URL=

# Only used by the `postgres` service in docker-compose.yml. The password has
# to be different for every installation, so it belongs here and not in
# config.env.
POSTGRES_USER=journal
POSTGRES_PASSWORD=
POSTGRES_DB=journal

# ---------------------------------------------------------------------------
# Per machine overrides (optional)
# ---------------------------------------------------------------------------

# Anything in config.env can be overridden here, by copying the variable and
# giving it the value of this machine. The two that come up most often:
#
# WJ_COOKIE_SECURE=true
# WJ_LOG_FORMAT=text
