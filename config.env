# Wei Journal - the settings of the installation
#
# This file belongs in version control. It holds no secret, so it travels
# with the code and every machine starts out with the same behaviour.
#
# The secrets are NOT here. The password of the first administrator, the key
# of the model provider and the password of PostgreSQL live in `.env`, which
# is not committed. See `.env.example` for that file.
#
# A value in `.env` overrides the same value here, so the differences between
# two machines (a different port, a different database, a different model)
# belong in `.env` and the shared behaviour belongs here.
#
# The Compose file sets a few values on its own and they win over this file:
# the paths inside the container (/data), the listening address and the build
# version, which has to match the tag of the image.

# ---------------------------------------------------------------------------
# Accounts and sessions
# ---------------------------------------------------------------------------

# Set to false to close the registration once the accounts exist.
WJ_ALLOW_REGISTRATION=true

# How long a session may sit unused before the next request has to renew it.
# Seven days. While the journal is actually being used, the deadline below
# slides forward, so an open session is not cut off at this mark.
WJ_SESSION_TTL=168h

# How far each renewal reaches. Activity moves this deadline forward by the
# same amount, so someone who keeps the journal open stays signed in.
WJ_REFRESH_TTL=720h

# The number of requests a single identity may send per minute.
WJ_RATE_LIMIT_PER_MIN=120

# ---------------------------------------------------------------------------
# Cookies and network
# ---------------------------------------------------------------------------

# Set to true when the installation is served over HTTPS. The session and the
# CSRF cookie are only marked Secure when this is enabled, so leaving it
# false behind TLS means the cookies travel without the Secure flag.
WJ_COOKIE_SECURE=false

# The domain the cookies are scoped to, for example `.example.com`. Empty
# means host only cookies, which is the right default for a single hostname.
WJ_COOKIE_DOMAIN=

# The origins allowed to call the API with credentials. Only needed when the
# API is served from another origin than the interface. Comma separated for
# several origins.
WJ_TRUSTED_ORIGINS=

# Set to true when a reverse proxy in front of the application sets
# X-Forwarded-For. The header is then read from it, but only from a proxy on
# the loopback interface or on the private container bridge. A client that
# reaches the server directly is never believed.
WJ_TRUSTED_PROXY=true

# The exact addresses of the proxies whose X-Forwarded-For header may be
# believed, as a comma separated list of addresses or CIDR ranges. When this
# is set it replaces the list above, so use it when the proxy runs on
# another machine. Empty otherwise.
WJ_TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# The maximum size of a single upload in megabytes. The reverse proxy must
# allow at least as much, otherwise the upload fails with 413 before it
# reaches the application.
WJ_MAX_UPLOAD_MB=256

# ---------------------------------------------------------------------------
# Background work
# ---------------------------------------------------------------------------

# The number of workers that process the job queue. Each worker handles one
# job at a time.
WJ_JOB_WORKERS=2

# How often the workers look for the jobs that are due.
WJ_JOB_INTERVAL=2s

# The largest number of rows a single search may return.
WJ_MAX_SEARCH_ROWS=500

# ---------------------------------------------------------------------------
# AI features (optional)
# ---------------------------------------------------------------------------

# Set to false to switch the AI features off entirely. The journal works
# without them; only the derived image descriptions and the summaries are
# missing.
WJ_AI_ENABLED=true

# The base URL of the model provider. Any OpenAI compatible endpoint works.
OPENAI_BASE_URL=https://api.openai.com/v1

# The model that describes the images.
OPENAI_VISION_MODEL=gpt-4o-mini

# The model that summarises the entries.
OPENAI_TEXT_MODEL=gpt-4o-mini

# The timeout of a single model request.
WJ_AI_TIMEOUT=90s

# ---------------------------------------------------------------------------
# Maps and the place search (optional)
# ---------------------------------------------------------------------------

# Set to true to enable the external place search. It is off by default
# because it sends the typed place name to a third party service.
WJ_GEOCODING_ENABLED=false

# The Nominatim instance used for the place search.
WJ_GEOCODING_URL=https://nominatim.openstreetmap.org

# The user agent sent to the place search. Identify yourself here.
WJ_GEOCODING_USER_AGENT="wei-journal/1.0 (self-hosted journal)"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug or info.
WJ_LOG_LEVEL=info

# json or text. Use json when the logs are collected by a log system.
WJ_LOG_FORMAT=json
